# Server Configuration
PORT=8080

# Supabase PostgreSQL Database Configuration
SUPABASE_DB_URL=jdbc:postgresql://<db-host>:5432/<db-name>
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your_db_password

# Supabase API & Auth Configuration
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_ISSUER=https://<your-project-id>.supabase.co/auth/v1
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_min_32_characters

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
